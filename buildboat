end
end
local function applyGodMode(character)
if not godModeActive or not character then return end
local humanoid = character:WaitForChild("Humanoid", 5)
if humanoid then
humanoid.WalkSpeed = 16
local animate = character:FindFirstChild("Animate")
if animate then
animate.Disabled = true
task.wait(0.05)
if character and animate then
animate.Disabled = false
end
end
end
local localCombat = character:FindFirstChild("LocalCombat")
if localCombat then
localCombat:Destroy()
end
for _, part in pairs(character:GetChildren()) do
if part:IsA("BasePart") then
if part.Name == "HumanoidRootPart" then
part.CanTouch = true
else
part.CanTouch = false
end
end
end
cleanSelectionOutlines()
if godModeConnection then
godModeConnection:Disconnect()
godModeConnection = nil
end
godModeConnection = RunService.Heartbeat:Connect(function()
if godModeActive and character and character.Parent and humanoid and humanoid.Parent then
if humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
humanoid.Health = humanoid.MaxHealth
end
humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
if humanoid:GetState() == Enum.HumanoidStateType.None then
humanoid:ChangeState(Enum.HumanoidStateType.Running)
end
cleanSelectionOutlines()
else
if godModeConnection then
godModeConnection:Disconnect()
godModeConnection = nil
end
end
end)
end
