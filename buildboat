local function manualMoveToCFrame(targetCFrame)
local root = getViableRoot(player.Character)
if not root then return end
local startCFrame = root.CFrame
local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
local duration = distance / speed
local startTime = os.clock()
workspace.Gravity = 0
while isRunning and (os.clock() - startTime) < duration do
local activeRoot = getViableRoot(player.Character)
if not activeRoot then break end
local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
activeRoot.CFrame = startCFrame:Lerp(targetCFrame, alpha)
activeRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
activeRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
RunService.Heartbeat:Wait()
end
local finalRoot = getViableRoot(player.Character)
if isRunning and finalRoot then
finalRoot.CFrame = targetCFrame
end
end
