if flyActive and root then
local camera = workspace.CurrentCamera
if not flyBodyGyro or flyBodyGyro.Parent ~= root then
if flyBodyGyro then flyBodyGyro:Destroy() end
flyBodyGyro = Instance.new("BodyGyro", root)
flyBodyGyro.P = 9e4
flyBodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
end
if not flyBodyVelocity or flyBodyVelocity.Parent ~= root then
if flyBodyVelocity then flyBodyVelocity:Destroy() end
flyBodyVelocity = Instance.new("BodyVelocity", root)
flyBodyVelocity.velocity = Vector3.new(0, 0, 0)
flyBodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
end
flyBodyGyro.cframe = camera.CFrame
local directionVector = Vector3.new(0, 0, 0)
if keysDown[Enum.KeyCode.W] then directionVector = directionVector + camera.CFrame.LookVector end
if keysDown[Enum.KeyCode.S] then directionVector = directionVector - camera.CFrame.LookVector end
if keysDown[Enum.KeyCode.A] then directionVector = directionVector - camera.CFrame.RightVector end
if keysDown[Enum.KeyCode.D] then directionVector = directionVector + camera.CFrame.RightVector end
if keysDown[Enum.KeyCode.Space] then directionVector = directionVector + Vector3.new(0, 1, 0) end
if keysDown[Enum.KeyCode.LeftShift] then directionVector = directionVector - Vector3.new(0, 1, 0) end
flyBodyVelocity.velocity = directionVector.Unit * flySpeed
if directionVector == Vector3.new(0,0,0) then
flyBodyVelocity.velocity = Vector3.new(0,0,0)
end
else
if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
end
end
end)
local function autoFarmLoop()
while isRunning do
local char = player.Character or player.CharacterAdded:Wait()
local root = getViableRoot(char)
if not root then
task.wait(0.5)
continue
end
for i, cf in ipairs(destinations) do
if not isRunning then return end
manualMoveToCFrame(cf)
end
workspace.Gravity = gravityNormal
repeat task.wait(1) until player.CharacterAdded:Wait()
end
end
