local function cleanSelectionOutlines()
if not godModeActive then return end
local pGui = player:FindFirstChild("PlayerGui")
if pGui then
for _, child in pairs(pGui:GetChildren()) do
if child:IsA("SelectionBox") or child:IsA("Highlight") or child:IsA("BoxHandleAdornment") or child.Name:lower():match("outline") or child.Name:lower():match("selection") or child.Name:lower():match("flash") or child.Name:lower():match("damage") or child.Name == "HealthGui" then
child:Destroy()
end
end
end
for _, child in pairs(workspace:GetChildren()) do
if child:IsA("SelectionBox") or child:IsA("Highlight") or child:IsA("BoxHandleAdornment") then
child:Destroy()
end
end
if player.Character then
for _, obj in pairs(player.Character:GetDescendants()) do
if obj:IsA("SelectionBox") or obj:IsA("Highlight") or obj:IsA("BoxHandleAdornment") then
obj:Destroy()
end
end
end
local currentCamera = workspace.CurrentCamera
if currentCamera then
for _, child in pairs(currentCamera:GetChildren()) do
if child:IsA("ScreenGui") or child:IsA("Frame") or child.Name:lower():match("flash") or child.Name:lower():match("damage") then
